!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Additional local credential formats
/.venv/
/.secrets/
*.key
*.p12
*.pfx
*.token
/wrangler-credentials*.json
/oauth-credentials*.json

# Only the empty local template is safe to share.
!/.dev.vars.example
